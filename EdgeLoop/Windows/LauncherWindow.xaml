<controls:EdgeLoopWindow x:Class="EdgeLoop.Windows.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:EdgeLoop.Controls"
        mc:Ignorable="d"
        Title="EdgeLoop" Width="700" Height="750" MinWidth="600" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        CloseCommand="{Binding ExitCommand}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Below 650px wide (the window's content, LayoutRoot) the playlist buttons lose their labels -->
        <Style x:Key="WideLayoutOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=LayoutRoot, Converter={StaticResource LessThanConverter}, ConverterParameter=650}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NarrowLayoutOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=LayoutRoot, Converter={StaticResource LessThanConverter}, ConverterParameter=650}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small square icon buttons in the Now Playing rows -->
        <Style x:Key="ActivePlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Browse / Add URL -->
        <Style x:Key="MainActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentPrimary}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start Playback, which turns into the red Stop Playback while anything plays -->
        <Style x:Key="TrainingToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource MainButton}">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="Command" Value="{Binding HypnotizeCommand}"/>
            <Setter Property="IsEnabled" Value="{Binding IsHypnotizeEnabled}"/>
            <!-- Also explains a disabled Start ("Add videos first") -->
            <Setter Property="ToolTip" Value="{Binding StartHint}"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="24,10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasActivePlayers}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    <Setter Property="Command" Value="{Binding DehypnotizeCommand}"/>
                    <Setter Property="IsEnabled" Value="True"/>
                    <Setter Property="ToolTip" Value="Stop playback on every screen"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasActivePlayers}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "Remove failed (2)", shown only while some videos failed to play -->
        <Style x:Key="RemoveFailedButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryDangerButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FailedCount}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small status labels on a playlist card -->
        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
            A playlist card; hover, selection and problems show on its outline. For the keyboard, Tab
            reaches the selected card (or the first, if none is) and then its controls; the arrow keys
            move between cards.
        -->
        <Style x:Key="PlaylistItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Card"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentSecondary}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardMissingBorderBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PlaybackFailed}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardFailedBorderBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="IsTabStop" Value="True"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" Value="0"/>
                        <Condition Binding="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType=ListView}}" Value="-1"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsTabStop" Value="True"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <controls:EdgeLoopWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource TitleBarButtonStyle}" Click="AboutButton_Click" ToolTip="About EdgeLoop" AutomationProperties.Name="About">
                <Path Data="{StaticResource Icon_Info}" Stretch="Uniform" Width="15" Height="15"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Button Style="{StaticResource TitleBarButtonStyle}" Click="SettingsButton_Click" ToolTip="Settings" AutomationProperties.Name="Settings">
                <Path Data="{StaticResource Icon_Settings}" Stretch="Uniform" Width="15" Height="15"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
        </StackPanel>
    </controls:EdgeLoopWindow.TitleBarContent>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Title and add buttons -->
            <RowDefinition Height="Auto"/> <!-- 1: Playlist header -->
            <RowDefinition Height="*"/>    <!-- 2: Playlist -->
            <RowDefinition Height="Auto"/> <!-- 3: Status -->
            <RowDefinition Height="Auto"/> <!-- 4: Now Playing -->
            <RowDefinition Height="Auto"/> <!-- 5: Shuffle and Start/Stop -->
        </Grid.RowDefinitions>

        <!-- Row 0: Title and add buttons -->
        <StackPanel Grid.Row="0" Margin="24,8,24,10">
            <StackPanel Margin="0,4,0,14">
                <Label Style="{StaticResource GlowingTitleStyle}" FontSize="28" Padding="0" Margin="0,0,0,2">EDGELOOP</Label>
                <TextBlock Style="{StaticResource LowerTitle}" FontStyle="Italic" FontSize="13" HorizontalAlignment="Center">Advanced multi-monitor overlay engine</TextBlock>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BrowseButton" Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource MainActionButtonStyle}" Command="{Binding BrowseCommand}"
                        ToolTip="Add video files from your computer">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon_Folder}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Browse videos"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AddUrlOrPlaylistButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource MainActionButtonStyle}" Command="{Binding AddUrlOrPlaylistCommand}"
                        ToolTip="Add a video page or a playlist from a supported site">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon_Link}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Add URL"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Row 1: Playlist header -->
        <Grid Grid.Row="1" Margin="24,0,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center">
                <Run Text="Playlist" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
                <Run Text=" (" Foreground="{StaticResource TextSecondary}" FontSize="13"/><Run Text="{Binding AddedFiles.Count, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="13"/><Run Text=" " Foreground="{StaticResource TextSecondary}" FontSize="13"/><Run Text="{Binding AddedFiles.Count, Mode=OneWay, Converter={StaticResource PluralConverter}}" Foreground="{StaticResource TextSecondary}" FontSize="13"/><Run Text=")" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
            </TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RemoveFailedCommand}" Style="{StaticResource RemoveFailedButtonStyle}" Padding="12,0" Margin="0,0,8,0" Height="32"
                        ToolTip="Remove every video that failed to play">
                    <TextBlock FontSize="12" FontWeight="SemiBold">
                        <Run Text="Remove failed ("/><Run Text="{Binding FailedCount, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                </Button>

                <StackPanel Orientation="Horizontal" Style="{StaticResource WideLayoutOnly}">
                    <Button Command="{Binding LoadPlaylistCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,0" Margin="0,0,8,0" Height="32" ToolTip="Load a saved playlist">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_Folder}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Load" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SavePlaylistCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,0" Margin="0,0,8,0" Height="32" ToolTip="Save this playlist to a file">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_Save}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Save" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,0" Height="32" ToolTip="Remove every video from the playlist">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_Trash}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Clear" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Style="{StaticResource NarrowLayoutOnly}">
                    <Button Command="{Binding LoadPlaylistCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,4,0"
                            ToolTip="Load a saved playlist" AutomationProperties.Name="Load playlist">
                        <Path Data="{StaticResource Icon_Folder}" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                    <Button Command="{Binding SavePlaylistCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="36" Height="32" Padding="0" Margin="0,0,4,0"
                            ToolTip="Save this playlist to a file" AutomationProperties.Name="Save playlist">
                        <Path Data="{StaticResource Icon_Save}" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                    <Button Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="36" Height="32" Padding="0"
                            ToolTip="Remove every video from the playlist" AutomationProperties.Name="Clear playlist">
                        <Path Data="{StaticResource Icon_Trash}" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Row 2: Playlist. The ListView scrolls by itself, so only the visible cards are built. -->
        <Grid Grid.Row="2" Margin="24,0,24,0" MinHeight="160">
            <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="10"/>
            <Border x:Name="PlaylistDropZone" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="Tag" Value="DragOver">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ListView x:Name="AddedFilesList"
                          ItemsSource="{Binding AddedFiles}"
                          ItemContainerStyle="{StaticResource PlaylistItemStyle}"
                          SelectionMode="Single"
                          AlternationCount="2147483647"
                          IsTabStop="False"
                          KeyboardNavigation.TabNavigation="Continue"
                          PreviewGotKeyboardFocus="AddedFilesList_PreviewGotKeyboardFocus"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="6,6,14,0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Playlist"
                          AllowDrop="True"
                          KeyDown="AddedFilesList_KeyDown"
                          PreviewMouseLeftButtonDown="AddedFilesList_PreviewMouseLeftButtonDown"
                          MouseMove="AddedFilesList_MouseMove"
                          Drop="AddedFilesList_Drop"
                          DragOver="AddedFilesList_DragOver"
                          DragEnter="AddedFilesList_DragEnter"
                          DragLeave="AddedFilesList_DragLeave">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Web or local -->
                                    <Grid Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border Background="{StaticResource AccentPrimary}" CornerRadius="5" ToolTip="Web video"
                                                Visibility="{Binding IsUrl, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Data="{StaticResource Icon_Globe}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" Margin="5"/>
                                        </Border>
                                        <Border Background="{StaticResource SuccessColor}" CornerRadius="5" ToolTip="Local file"
                                                Visibility="{Binding IsUrl, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                            <Path Data="{StaticResource Icon_File}" Fill="{StaticResource BadgeDarkTextBrush}" Stretch="Uniform" Margin="5"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" ToolTip="{Binding Location}"
                                                   Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource TextTertiary}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DurationText, StringFormat='· {0}'}" Foreground="{StaticResource TextTertiary}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Visibility="{Binding DurationText, Converter={StaticResource StringToVisibilityConverter}}"/>

                                            <Border Style="{StaticResource BadgeBorder}" Background="{StaticResource AccentPrimary}"
                                                    ToolTip="{Binding AssignedScreen.DisplayName, StringFormat='Playing now on {0}'}"
                                                    Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="PLAYING" Style="{StaticResource BadgeText}"/>
                                            </Border>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{StaticResource DangerBrush}"
                                                    ToolTip="{Binding PlaybackError, StringFormat='{}{0}. It will be tried again the next time you start playback.'}"
                                                    Visibility="{Binding PlaybackFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="FAILED" Style="{StaticResource BadgeText}"/>
                                            </Border>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{StaticResource WarningColor}"
                                                    ToolTip="{Binding ValidationError}"
                                                    Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="MISSING" Style="{StaticResource BadgeText}" Foreground="{StaticResource BadgeDarkTextBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource BadgeBorder}" Background="{StaticResource SuccessColor}"
                                                    ToolTip="Downloaded: plays from the local cache"
                                                    Visibility="{Binding IsCached, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="CACHED" Style="{StaticResource BadgeText}" Foreground="{StaticResource BadgeDarkTextBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <ComboBox Grid.Column="2" Width="220" Margin="12,0,0,0" VerticalAlignment="Center"
                                              ItemsSource="{Binding DataContext.AvailableScreens, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding AssignedScreen}"
                                              ItemTemplate="{StaticResource ScreenPickerItem}"
                                              ToolTip="Screen this video plays on"
                                              IsTabStop="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                              AutomationProperties.Name="Screen"/>
                                    <Button Grid.Column="3" Style="{StaticResource ControlButton}" Width="26" Height="26" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            ToolTip="Remove from playlist (Delete)" AutomationProperties.Name="Remove"
                                            IsTabStop="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}">
                                        <Path Data="{StaticResource Icon_Close}" Stretch="Uniform" Width="10" Height="10"/>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Opacity" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Slider Grid.Column="1" Value="{Binding Opacity, Converter={StaticResource OpacityScaleConverter}}" Minimum="0" Maximum="1"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" AutomationProperties.Name="Opacity"
                                            IsTabStop="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Opacity, Converter={StaticResource OpacityToIntConverter}, StringFormat='{}{0}%'}" Width="38" TextAlignment="Right"
                                               Foreground="{StaticResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Volume" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Slider Grid.Column="5" Value="{Binding Volume}" Minimum="0" Maximum="1"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" AutomationProperties.Name="Volume"
                                            IsTabStop="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Volume, StringFormat=P0}" Width="38" TextAlignment="Right"
                                               Foreground="{StaticResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Empty playlist -->
            <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                        Visibility="{Binding HasItems, ElementName=AddedFilesList, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                <Path Data="{StaticResource Icon_Folder}" Fill="{StaticResource AccentSecondary}" Stretch="Uniform" Width="56" Height="56" Opacity="0.4" Margin="0,0,0,18"/>
                <TextBlock Text="Drag &amp; drop videos or links here" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Or use Browse videos for files, and Add URL for a video page or playlist"
                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Row 3: Status -->
        <Border x:Name="StatusBorder" Grid.Row="3" CornerRadius="8" Margin="24,8,24,0" Padding="14,6,6,6"
                Background="{Binding StatusMessageType, Converter={StaticResource StatusMessageTypeToBrushConverter}}"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessageType, Converter={StaticResource StatusMessageTypeToForegroundConverter}}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <!-- e.g. Undo after removing videos -->
                <Button Grid.Column="1" Content="{Binding StatusActionText}" Command="{Binding StatusActionCommand}"
                        Visibility="{Binding StatusActionText, Converter={StaticResource StringToVisibilityConverter}}"
                        Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="12,0" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource ControlButton}" Command="{Binding DismissStatusCommand}" Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center"
                        ToolTip="Dismiss" AutomationProperties.Name="Dismiss message">
                    <Path Data="{StaticResource Icon_Close}" Fill="{Binding StatusMessageType, Converter={StaticResource StatusMessageTypeToForegroundConverter}}" Stretch="Uniform" Width="9" Height="9"/>
                </Button>
            </Grid>
        </Border>

        <!-- Row 4: Now Playing -->
        <StackPanel Grid.Row="4" Margin="24,8,24,0" Visibility="{Binding HasActivePlayers, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource LowerTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Text="Now playing"/>
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ActivePlayers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" CornerRadius="8" BorderBrush="{StaticResource AccentPrimary}" BorderThickness="1.5" Background="{StaticResource SurfaceBrush}" Padding="14,4,6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ScreenName}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentVideoTitle}" ToolTip="{Binding CurrentVideoTitle}" Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- The last failure on this screen, until the next video opens -->
                                        <TextBlock Text="{Binding Problem}" ToolTip="{Binding Problem}" Foreground="{StaticResource ErrorTextBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                   Visibility="{Binding Problem, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding PreviousCommand}" Style="{StaticResource ActivePlayerButtonStyle}" ToolTip="Previous video" AutomationProperties.Name="Previous video">
                                        <Path Data="{StaticResource Icon_Next}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="13" Height="13"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="-1"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Button>
                                    <Button Grid.Column="3" Command="{Binding TogglePlayPauseCommand}" Style="{StaticResource ActivePlayerButtonStyle}" ToolTip="Play/pause" AutomationProperties.Name="Play or pause">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="13" Height="13">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource Icon_Play}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource Icon_Pause}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>
                                    <Button Grid.Column="4" Command="{Binding SkipCommand}" Style="{StaticResource ActivePlayerButtonStyle}" ToolTip="Next video" AutomationProperties.Name="Next video">
                                        <Path Data="{StaticResource Icon_Next}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="13" Height="13"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Row 5: Shuffle and Start/Stop -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderPink}" BorderThickness="0,1,0,0" Padding="24,12,24,14" Margin="0,10,0,0">
            <StackPanel>
                <CheckBox x:Name="ShuffleCheckBox" IsChecked="{Binding Shuffle}" Content="Shuffle"
                          Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold"
                          HorizontalAlignment="Center" Margin="0,0,0,10"
                          ToolTip="Play each screen's videos in random order"/>

                <Button x:Name="TrainingToggleButton" Style="{StaticResource TrainingToggleButtonStyle}" HorizontalAlignment="Stretch"
                        CommandParameter="{Binding ElementName=AddedFilesList, Path=SelectedItems}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasActivePlayers, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource Icon_Play}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,10,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Start playback" FontWeight="SemiBold" FontSize="15"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasActivePlayers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource Icon_Stop}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Stop playback" FontWeight="SemiBold" FontSize="15"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <!-- Busy overlay (all rows) -->
        <Grid Grid.RowSpan="6" Background="{StaticResource ScrimBrush}" Panel.ZIndex="1000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="60" Height="60">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="UnifiedSpinnerTransform" CenterX="30" CenterY="30"/>
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="UnifiedSpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Path Data="M 30,0 A 30,30 0 0 1 60,30" Stroke="{StaticResource AccentPrimary}" StrokeThickness="5"/>
                    <Path Data="M 60,30 A 30,30 0 0 1 0,30" Stroke="{StaticResource TextSecondary}" StrokeThickness="5" Opacity="0.3"/>
                </Grid>
                <TextBlock Text="{Binding ImportProgressText}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                <ProgressBar Width="200" Height="4" Value="{Binding ImportProgressValue}" Background="{StaticResource TrackBrush}" Foreground="{StaticResource AccentPrimary}" BorderThickness="0"
                             IsIndeterminate="{Binding ImportProgressValue, Converter={StaticResource IsProgressIndeterminateConverter}}"/>
                <Button Command="{Binding CancelImportCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,20,0,0" Padding="30,8" Content="Cancel import"/>
            </StackPanel>
        </Grid>
    </Grid>
</controls:EdgeLoopWindow>
