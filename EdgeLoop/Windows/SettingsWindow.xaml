<controls:EdgeLoopWindow x:Class="EdgeLoop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:EdgeLoop.Controls"
        mc:Ignorable="d"
        Title="Settings"
        Width="780" Height="620" MinWidth="640" MinHeight="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Title, description and "Reset to defaults" at the top of a section -->
        <DataTemplate x:Key="SectionHeader">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource WindowHeaderTitleStyle}"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource WindowHeaderSubtitleStyle}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource LinkButtonStyle}" VerticalAlignment="Top" Margin="12,4,0,0"
                        Content="Reset to defaults" ToolTip="Put this section back to the default values (applies when you save)"
                        Command="{Binding DataContext.ResetSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Section}"/>
            </Grid>
        </DataTemplate>

        <!-- A hotkey: name and description, the key box, and any problem with the keys -->
        <DataTemplate x:Key="HotkeyRow">
            <controls:SettingRow Header="{Binding Title}" Description="{Binding Description}">
                <StackPanel Width="200">
                    <controls:HotkeyRecorder Modifiers="{Binding Modifiers}" KeyName="{Binding Key}" AutomationProperties.Name="{Binding Title}"/>
                    <TextBlock Text="{Binding Problem}" Style="{StaticResource HotkeyProblemText}"
                               Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </controls:SettingRow>
        </DataTemplate>

        <!-- A site's cookies: hidden as dots unless "Show" is on, with Paste and Clear -->
        <Style x:Key="SecretBox" TargetType="Border">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sections -->
        <Border Background="{StaticResource SurfaceSunkenBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                     ItemContainerStyle="{StaticResource SettingsNavItemStyle}"
                     Background="Transparent" BorderThickness="0" Margin="10,14,10,10"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Settings sections">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- The selected section -->
        <ScrollViewer x:Name="ContentScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20,24,8">
            <Grid MaxWidth="640" HorizontalAlignment="Left">

                <!-- Playback -->
                <StackPanel Visibility="{Binding SelectedSection.Section, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Playback}">
                    <ContentPresenter Content="{Binding SelectedSection}" ContentTemplate="{StaticResource SectionHeader}"/>

                    <controls:SettingRow Header="Default screen" Note="New videos" Description="Where videos you add start out playing">
                        <ComboBox Width="250" ItemsSource="{Binding AvailableMonitors}" SelectedItem="{Binding SelectedDefaultMonitor}"
                                  ItemTemplate="{StaticResource ScreenPickerItem}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Header="Default opacity" Note="New videos"
                                         Description="How solid new videos start out. 100% is the most a video gets outside Opaque Mode.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="160" Value="{Binding DefaultOpacity, Converter={StaticResource OpacityScaleConverter}}"
                                    Minimum="0" Maximum="1" SmallChange="0.1" LargeChange="0.1" TickFrequency="0.1" TickPlacement="BottomRight" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding DefaultOpacity, Converter={StaticResource OpacityToIntConverter}, StringFormat='{}{0}%'}"
                                       Width="44" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </controls:SettingRow>

                    <controls:SettingRow Header="Default volume" Note="New videos" Description="How loud new videos start out">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="160" Value="{Binding DefaultVolume}"
                                    Minimum="0" Maximum="1" SmallChange="0.1" LargeChange="0.1" TickFrequency="0.1" TickPlacement="BottomRight" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding DefaultVolume, StringFormat=P0}" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </controls:SettingRow>

                    <controls:SettingRow Header="Opaque Mode" Description="Every video is fully solid, not see-through. Press the emergency stop key (Esc) three times to stop.">
                        <CheckBox IsChecked="{Binding AlwaysOpaque}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Header="AI upscaling" Description="Sharper video with NVIDIA RTX Video or Intel XeSS, if your graphics card supports it">
                        <CheckBox IsChecked="{Binding EnableSuperResolution}"/>
                    </controls:SettingRow>

                    <controls:SettingRow Header="Notices when a video can't play" Description="A short message in the corner of that screen, which fades after a few seconds">
                        <CheckBox IsChecked="{Binding ShowPlaybackNotices}"/>
                    </controls:SettingRow>
                </StackPanel>

                <!-- Library & Cache -->
                <StackPanel Visibility="{Binding SelectedSection.Section, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Library}">
                    <ContentPresenter Content="{Binding SelectedSection}" ContentTemplate="{StaticResource SectionHeader}"/>

                    <TextBlock Text="PLAYLIST AND POSITIONS" Style="{StaticResource SettingsGroupHeader}"/>
                    <controls:SettingRow Header="Remember last playlist" Description="Open EdgeLoop with the playlist you had last time">
                        <CheckBox IsChecked="{Binding RememberLastPlaylist}"/>
                    </controls:SettingRow>
                    <controls:SettingRow Header="Remember where each video was" Description="Resume videos where you left off">
                        <CheckBox IsChecked="{Binding RememberFilePosition}"/>
                    </controls:SettingRow>
                    <controls:SettingRow Header="Saved positions" Description="Forget where you were in every video. Happens right away, not when you save.">
                        <Button Command="{Binding ResetPositionsCommand}" Style="{StaticResource SecondaryDangerButtonStyle}" Height="32" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Trash}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Reset positions" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </controls:SettingRow>

                    <TextBlock Text="DOWNLOADS" Style="{StaticResource SettingsGroupHeader}"/>
                    <controls:SettingRow Header="Download web videos while they play" Description="Keeps a copy on disk, for instant seeking and smooth playback">
                        <CheckBox IsChecked="{Binding EnableLocalCaching}"/>
                    </controls:SettingRow>
                    <controls:SettingRow Header="Download folder" IsStacked="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LocalCacheDirectory, Mode=OneWay}" IsReadOnly="True" Height="32" Padding="10,0" FontSize="12"
                                     Foreground="{StaticResource TextSecondary}" ToolTip="{Binding LocalCacheDirectory}"
                                     AutomationProperties.Name="Download folder"/>
                            <Button Grid.Column="1" Command="{Binding BrowseCacheDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Browse…" Margin="8,0,0,0" Height="32" Padding="14,0"/>
                        </Grid>
                    </controls:SettingRow>
                </StackPanel>

                <!-- Privacy & Cookies -->
                <StackPanel Visibility="{Binding SelectedSection.Section, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Privacy}">
                    <ContentPresenter Content="{Binding SelectedSection}" ContentTemplate="{StaticResource SectionHeader}"/>

                    <Border Background="{StaticResource WarningBannerBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,18"
                            Visibility="{Binding CookieEncryptionAvailable, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarningTextBrush}"
                                   Text="Windows couldn't encrypt data on this PC, so cookies you enter here are saved as plain text in settings.json."/>
                    </Border>

                    <controls:SettingRow Header="Browser to sign in with" Description="EdgeLoop borrows this browser's sign-ins for sites such as Iwara">
                        <ComboBox Width="160" ItemsSource="{Binding AvailableBrowsers}" SelectedItem="{Binding BrowserForCookies}"/>
                    </controls:SettingRow>

                    <Grid Margin="0,6,0,12">
                        <TextBlock Text="SITE COOKIES" Style="{StaticResource SectionLabelText}" VerticalAlignment="Center"/>
                        <CheckBox HorizontalAlignment="Right" IsChecked="{Binding ShowCookies}" Content="Show" FontSize="12"
                                  ToolTip="Cookies sign you in to the site: keep them private"/>
                    </Grid>

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,14"
                               Text="Paste a site's cookies here if signing in through the browser doesn't work. They're stored encrypted for your Windows account."/>

                    <controls:SettingRow Header="Hypnotube" Description="Looks like PHPSESSID=…; other=…" IsStacked="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SecretBox}" Visibility="{Binding ShowCookies, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding HypnotubeCookies, Converter={StaticResource SecretMaskConverter}}" VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}"/>
                            </Border>
                            <TextBox Text="{Binding HypnotubeCookies, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="10,0" FontSize="12"
                                     AutomationProperties.Name="Hypnotube cookies"
                                     Visibility="{Binding ShowCookies, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Grid.Column="1" Command="{Binding PasteCookiesCommand}" CommandParameter="Hypnotube" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Paste" Height="32" Padding="12,0" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Command="{Binding ClearCookiesCommand}" CommandParameter="Hypnotube" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Clear" Height="32" Padding="12,0" Margin="6,0,0,0"/>
                        </Grid>
                    </controls:SettingRow>

                    <controls:SettingRow Header="Iwara" Description="Looks like sid=…; other=…" IsStacked="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SecretBox}" Visibility="{Binding ShowCookies, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding IwaraCookies, Converter={StaticResource SecretMaskConverter}}" VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}"/>
                            </Border>
                            <TextBox Text="{Binding IwaraCookies, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="10,0" FontSize="12"
                                     AutomationProperties.Name="Iwara cookies"
                                     Visibility="{Binding ShowCookies, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Grid.Column="1" Command="{Binding PasteCookiesCommand}" CommandParameter="Iwara" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Paste" Height="32" Padding="12,0" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Command="{Binding ClearCookiesCommand}" CommandParameter="Iwara" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Clear" Height="32" Padding="12,0" Margin="6,0,0,0"/>
                        </Grid>
                    </controls:SettingRow>

                    <controls:SettingRow Header="Rule34Video" Description="Looks like PHPSESSID=…; other=…" IsStacked="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SecretBox}" Visibility="{Binding ShowCookies, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Rule34VideoCookies, Converter={StaticResource SecretMaskConverter}}" VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}"/>
                            </Border>
                            <TextBox Text="{Binding Rule34VideoCookies, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="10,0" FontSize="12"
                                     AutomationProperties.Name="Rule34Video cookies"
                                     Visibility="{Binding ShowCookies, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Grid.Column="1" Command="{Binding PasteCookiesCommand}" CommandParameter="Rule34Video" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Paste" Height="32" Padding="12,0" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Command="{Binding ClearCookiesCommand}" CommandParameter="Rule34Video" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Clear" Height="32" Padding="12,0" Margin="6,0,0,0"/>
                        </Grid>
                    </controls:SettingRow>

                    <TextBlock Text="GETTING YOUR COOKIES" Style="{StaticResource SettingsGroupHeader}"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10" LineHeight="19">
                        <Run Text="1. Copy the helper below."/><LineBreak/>
                        <Run Text="2. In your browser, open the site while signed in, press F12 and choose the Console tab."/><LineBreak/>
                        <Run Text="3. Paste the helper there and press Enter."/><LineBreak/>
                        <Run Text="4. Come back here and click Paste next to the site."/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Button Command="{Binding CopyCookieScriptCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M14.6,16.6L19.2,12L14.6,7.4L16,6L22,12L16,18L14.6,16.6M9.4,16.6L4.8,12L9.4,7.4L8,6L2,12L8,18L9.4,16.6Z" Stretch="Uniform" Width="12" Height="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Copy cookie helper" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="✓ Copied" Foreground="{StaticResource SuccessTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding CookieScriptCopied, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Hotkeys -->
                <StackPanel Visibility="{Binding SelectedSection.Section, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Hotkeys}">
                    <ContentPresenter Content="{Binding SelectedSection}" ContentTemplate="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,-8,0,18"
                               Text="Hotkeys work in every app, even when EdgeLoop isn't in front. Click a key box, then press the new keys."/>

                    <TextBlock Text="ALWAYS ACTIVE" Style="{StaticResource SettingsGroupHeader}"/>
                    <ContentControl Content="{Binding PanicHotkey}" ContentTemplate="{StaticResource HotkeyRow}" Focusable="False"/>
                    <ContentControl Content="{Binding ClearHotkey}" ContentTemplate="{StaticResource HotkeyRow}" Focusable="False"/>

                    <TextBlock Text="ONLY WHILE VIDEOS PLAY" Style="{StaticResource SettingsGroupHeader}" Margin="0,6,0,4"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,14"
                               Text="The rest of the time these keys work normally in other apps."/>
                    <ContentControl Content="{Binding SkipForwardHotkey}" ContentTemplate="{StaticResource HotkeyRow}" Focusable="False"/>
                    <ContentControl Content="{Binding SkipBackwardHotkey}" ContentTemplate="{StaticResource HotkeyRow}" Focusable="False"/>
                    <ContentControl Content="{Binding EscapeHotkey}" ContentTemplate="{StaticResource HotkeyRow}" Focusable="False"/>

                    <Grid Margin="0,6,0,4">
                        <TextBlock Text="SKIP KEYS FOR EACH SCREEN" Style="{StaticResource SectionLabelText}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Command="{Binding IdentifyScreensCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Height="28" Padding="12,0" FontSize="12" Content="Identify screens"
                                ToolTip="Shows each screen's number on it for a moment"/>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,12"
                               Text="Skip keys act on the screen under the mouse. Give a screen its own keys to skip it wherever the mouse is."/>

                    <ItemsControl ItemsSource="{Binding ScreenSkipSettings}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="14,10">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Details}" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox HorizontalAlignment="Right" IsChecked="{Binding UseOwnKeys}" Content="Own keys" FontSize="12"
                                                      ToolTip="Off: this screen follows the mouse with the skip keys above"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,0" Visibility="{Binding UseOwnKeys, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel DataContext="{Binding Forward}">
                                                <TextBlock Text="Skip forward" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                                <controls:HotkeyRecorder Modifiers="{Binding Modifiers}" KeyName="{Binding Key}" AutomationProperties.Name="{Binding Title}"/>
                                                <TextBlock Text="{Binding Problem}" Style="{StaticResource HotkeyProblemText}"
                                                           Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" DataContext="{Binding Backward}">
                                                <TextBlock Text="Skip back" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                                <controls:HotkeyRecorder Modifiers="{Binding Modifiers}" KeyName="{Binding Key}" AutomationProperties.Name="{Binding Title}"/>
                                                <TextBlock Text="{Binding Problem}" Style="{StaticResource HotkeyProblemText}"
                                                           Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DisconnectedScreensNote}" Style="{StaticResource CaptionText}" Margin="0,4,0,12"
                               Visibility="{Binding DisconnectedScreensNote, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Advanced -->
                <StackPanel Visibility="{Binding SelectedSection.Section, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Advanced}">
                    <ContentPresenter Content="{Binding SelectedSection}" ContentTemplate="{StaticResource SectionHeader}"/>

                    <controls:SettingRow Header="Start with Windows" Description="Open EdgeLoop when you sign in to Windows">
                        <CheckBox IsChecked="{Binding StartWithWindows}"/>
                    </controls:SettingRow>

                    <TextBlock Text="TROUBLESHOOTING" Style="{StaticResource SettingsGroupHeader}"/>
                    <controls:SettingRow Header="Diagnostic mode" Description="Writes a detailed diagnostics.log next to the normal log, with file paths and engine events, for bug reports">
                        <CheckBox IsChecked="{Binding EnableDiagnosticMode}"/>
                    </controls:SettingRow>
                    <controls:SettingRow Header="Log files" Description="Opens the folder with EdgeLoop's logs">
                        <Button Command="{Binding OpenDiagnosticsFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon_Folder}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Open log folder" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </controls:SettingRow>
                </StackPanel>

                <!-- Censoring (only listed when the feature is switched on) -->
                <StackPanel Visibility="{Binding SelectedSection.Section, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Censoring}">
                    <ContentPresenter Content="{Binding SelectedSection}" ContentTemplate="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,-8,0,18"
                               Text="Detects and covers content in the video itself. It runs on the decoded frame before the window's opacity is applied, so it keeps working at low opacity, unlike screen-capture tools."/>

                    <controls:SettingRow Header="Cover content in videos" Description="{Binding CensorModelStatus}">
                        <CheckBox IsChecked="{Binding EnableLocalCensor}"/>
                    </controls:SettingRow>
                    <controls:SettingRow Header="Model file" Description="Leave empty to use the one in the Models folder" IsStacked="True">
                        <TextBox Text="{Binding CensorModelPath, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="10,0"/>
                    </controls:SettingRow>
                    <controls:SettingRow Header="Sensitivity" Description="Lower catches more, and gets more false positives">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="160" Minimum="0.05" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding CensorConfidence}"/>
                            <TextBlock Text="{Binding CensorConfidence, StringFormat={}{0:0.00}}" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingRow>
                    <controls:SettingRow Header="Detection interval (ms)" Description="How often a frame is checked. Lower reacts faster and uses more CPU">
                        <TextBox Width="80" Height="32" Padding="10,0" TextAlignment="Center" Text="{Binding CensorIntervalMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:SettingRow>
                    <controls:SettingRow Header="Hold time (ms)" Description="How long a box stays after detection drops. Stops flicker">
                        <TextBox Width="80" Height="32" Padding="10,0" TextAlignment="Center" Text="{Binding CensorHoldMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </controls:SettingRow>
                    <controls:SettingRow Header="Box padding" Description="Grows each box so edges aren't left uncovered">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="160" Minimum="0" Maximum="0.5" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding CensorPadding}"/>
                            <TextBlock Text="{Binding CensorPadding, StringFormat={}{0:0.00}}" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingRow>
                    <TextBlock Text="WHAT TO COVER" Style="{StaticResource SettingsGroupHeader}"/>
                    <ItemsControl ItemsSource="{Binding CensorClassOptions}" Margin="0,0,0,14" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" Width="220" Margin="0,4,8,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:SettingRow Header="Show detection labels" Description="Draws the class and confidence on each box. For tuning only">
                        <CheckBox IsChecked="{Binding CensorShowLabels}"/>
                    </controls:SettingRow>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,12,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Unsaved changes" FontSize="12" Foreground="{StaticResource TextSecondary}"
                               Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="Two hotkeys use the same keys. Change one to save." FontSize="12" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasHotkeyConflicts, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="96" Margin="0,0,10,0" Content="Cancel"/>
                    <Button x:Name="SaveButton" Command="{Binding OkCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_Save}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Save" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</controls:EdgeLoopWindow>
