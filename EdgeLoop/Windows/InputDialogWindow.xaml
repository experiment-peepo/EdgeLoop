<controls:EdgeLoopWindow x:Class="EdgeLoop.Windows.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EdgeLoop.Controls"
        xmlns:local="clr-namespace:EdgeLoop.Windows"
        Title="{Binding DialogTitle}" Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel>
        <StackPanel Style="{StaticResource DialogContentPanel}">
            <Label Content="{Binding LabelText}"
                   Target="{Binding ElementName=InputTextBox}"
                   Foreground="{StaticResource TextPrimary}"
                   FontWeight="SemiBold"
                   FontSize="{StaticResource FontSizeBody}"
                   Padding="0"
                   Margin="0,0,0,8"/>
            <TextBox x:Name="InputTextBox"
                     Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{Binding Hint}"
                     Height="42"/>
            <TextBlock Text="{Binding Note}"
                       Style="{StaticResource CaptionText}"
                       Margin="0,8,0,0"
                       Visibility="{Binding Note, Converter={x:Static local:StringToVisibilityConverter.Instance}}"/>
        </StackPanel>

        <StackPanel Style="{StaticResource DialogButtonRow}">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Content="OK" MinWidth="96" IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OkButton_Click"/>
        </StackPanel>
    </StackPanel>
</controls:EdgeLoopWindow>
