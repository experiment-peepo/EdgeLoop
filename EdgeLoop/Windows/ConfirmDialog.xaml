<controls:EdgeLoopWindow x:Class="EdgeLoop.Windows.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EdgeLoop.Controls"
        Title="Confirm" Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel>
        <Grid Margin="24,22,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Path x:Name="MessageIcon"
                  Data="{StaticResource Icon_Info}"
                  Fill="{StaticResource AccentSecondary}"
                  Width="22" Height="22" Stretch="Uniform"
                  VerticalAlignment="Top" Margin="0,0,14,0"/>
            <TextBlock x:Name="MessageText" Grid.Column="1"
                       FontSize="{StaticResource FontSizeBody}"
                       LineHeight="21"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimary}"/>
        </Grid>

        <StackPanel Style="{StaticResource DialogButtonRow}">
            <Button x:Name="CancelButton" Content="No" MinWidth="96" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click"/>
            <Button x:Name="ConfirmButton" Content="Yes" MinWidth="96"
                    Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmButton_Click"/>
        </StackPanel>
    </StackPanel>
</controls:EdgeLoopWindow>
