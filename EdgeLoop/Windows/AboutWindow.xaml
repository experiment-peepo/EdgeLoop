<controls:EdgeLoopWindow x:Class="EdgeLoop.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EdgeLoop.Controls"
        Title="About EdgeLoop" SizeToContent="Height" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Content -->
    <StackPanel Margin="24,20,24,24">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="EDGELOOP" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center"/>
            <TextBlock Text="Advanced multi-monitor overlay engine" FontSize="14" FontStyle="Italic" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="VersionText" 
                       HorizontalAlignment="Center" 
                       Foreground="{StaticResource TextTertiary}" 
                       Margin="0,10,0,0" 
                       FontSize="12"/>
        </StackPanel>

        <TextBlock Text="EdgeLoop plays videos as see-through overlays on your desktop, on as many monitors as you have." 
                   Foreground="{StaticResource TextSecondary}" 
                   TextWrapping="Wrap" 
                   TextAlignment="Center"
                   FontSize="14"
                   LineHeight="20"
                   Margin="0,0,0,30"/>

        <!-- Support Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <!-- Ko-fi Button -->
            <Button Command="{Binding OpenKoFiCommand}" 
                    Background="Transparent" BorderBrush="Transparent"
                    Cursor="Hand" ToolTip="Support on Ko-fi" AutomationProperties.Name="Support on Ko-fi"
                    Margin="0,0,12,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                         <Grid>
                            <ContentPresenter/>
                            <Border Background="Transparent"/> 
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <Image Source="pack://application:,,,/EdgeLoop;component/Images/kofi.png" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="8" ShadowDepth="1" Opacity="0.3"/>
                    </Image.Effect>
                </Image>
            </Button>

            <!-- Patreon Button -->
            <Button Command="{Binding OpenPatreonCommand}" 
                    Background="Transparent" BorderBrush="Transparent"
                    Cursor="Hand" ToolTip="Support on Patreon" AutomationProperties.Name="Support on Patreon">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                         <Grid>
                            <ContentPresenter/>
                            <Border Background="Transparent"/> 
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <Image Source="pack://application:,,,/EdgeLoop;component/Images/patreon.png" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="8" ShadowDepth="1" Opacity="0.3"/>
                    </Image.Effect>
                </Image>
            </Button>
        </StackPanel>
        
        <TextBlock Text="Support development" 
                   Foreground="{StaticResource TextTertiary}" 
                   FontSize="11" 
                   HorizontalAlignment="Center" 
                   Margin="0,4,0,0"
                   FontStyle="Italic"/>
    </StackPanel>
</controls:EdgeLoopWindow>
