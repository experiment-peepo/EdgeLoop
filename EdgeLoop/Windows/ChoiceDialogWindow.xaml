<controls:EdgeLoopWindow x:Class="EdgeLoop.Windows.ChoiceDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EdgeLoop.Controls"
        Title="{Binding DialogTitle}" Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel>
        <Grid Margin="24,22,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Path Data="{StaticResource Icon_Info}" Fill="{StaticResource AccentSecondary}"
                  Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" Margin="0,0,14,0"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Message}"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       LineHeight="21"/>
        </Grid>

        <!-- Auto-select countdown, with a way to stop it -->
        <StackPanel Orientation="Horizontal" Margin="60,14,24,0">
            <TextBlock Text="{Binding CountdownText}"
                       Foreground="{StaticResource TextTertiary}"
                       FontSize="{StaticResource FontSizeCaption}"
                       VerticalAlignment="Center"/>
            <Button x:Name="PauseButton"
                    Style="{StaticResource ControlButton}"
                    Foreground="{StaticResource AccentSecondary}"
                    FontSize="{StaticResource FontSizeCaption}"
                    FontWeight="SemiBold"
                    Padding="4,1"
                    Margin="8,0,0,0"
                    Content="Wait"
                    ToolTip="Stop the countdown and choose yourself"
                    Click="PauseButton_Click"/>
        </StackPanel>

        <StackPanel Style="{StaticResource DialogButtonRow}">
            <Button x:Name="Option1Button" MinWidth="110" Margin="0,0,10,0" Padding="20,10"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="{Binding Option1Text}"
                    Click="Option1Button_Click"/>
            <Button x:Name="Option2Button" MinWidth="110" Padding="20,10"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="{Binding Option2Text}"
                    Click="Option2Button_Click"/>
        </StackPanel>
    </StackPanel>
</controls:EdgeLoopWindow>
