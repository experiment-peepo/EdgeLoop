	EdgeLoop's palette: deep magenta and midnight. Use the semantic brushes (Surface*, Danger, Focus...)
	in new markup; the original palette keys stay for existing references.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Raw colors (for effects and gradients, which need Color rather than Brush) -->
    <Color x:Key="SurfaceColor">#1A0510</Color>
    <Color x:Key="SurfaceRaisedColor">#3D0A1F</Color>
    <Color x:Key="AccentColor">#FF1493</Color>
    <Color x:Key="AccentLightColor">#FF69B4</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="WindowBorderColor">#A30E5E</Color>   <!-- 1px window outline (drawn by Windows 11 itself) -->

    <!-- Palette (original keys) -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="{StaticResource SurfaceColor}"/>        <!-- Main background -->
    <SolidColorBrush x:Key="BackgroundSecondary" Color="{StaticResource SurfaceRaisedColor}"/> <!-- Cards, panels, title bars -->
    <SolidColorBrush x:Key="AccentPrimary" Color="{StaticResource AccentColor}"/>              <!-- Hot pink -->
    <SolidColorBrush x:Key="AccentSecondary" Color="{StaticResource AccentLightColor}"/>       <!-- Hover / active pink -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFB6D9"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#EDAEC0"/>
    <SolidColorBrush x:Key="BorderPink" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#90EE90"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFD700"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#FF4444"/>

    <!-- Semantic brushes -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#4D0A1F"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#33000000"/>       <!-- Recessed areas such as the playlist well -->
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#CC1493"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#4DFF1493"/>        <!-- Card outlines -->
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#33FF1493"/>        <!-- Selected rows, info banner -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource WindowBorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#777777"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF4444"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#D32F2F"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#B0000000"/>              <!-- Behind busy overlays -->
    <SolidColorBrush x:Key="TrackBrush" Color="#30FFFFFF"/>              <!-- Progress bar background -->
    <SolidColorBrush x:Key="ScrollbarThumb" Color="#66FF1493"/>
    <SolidColorBrush x:Key="ScrollbarThumbHover" Color="#CCFF1493"/>
    <SolidColorBrush x:Key="SliderTickBrush" Color="#B3FF1493"/>        <!-- Dashes along a slider track -->

    <!-- Playback overlay -->
    <SolidColorBrush x:Key="VideoBackdropBrush" Color="#000000"/>        <!-- Behind the video -->
    <Color x:Key="EnhancedColor">#00FF99</Color>                          <!-- "AI Enhanced" label -->
    <SolidColorBrush x:Key="EnhancedBrush" Color="{StaticResource EnhancedColor}"/>

    <!-- Playlist cards -->
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#99FF69B4"/>
    <SolidColorBrush x:Key="CardFailedBorderBrush" Color="#99FF4444"/>
    <SolidColorBrush x:Key="CardMissingBorderBrush" Color="#99FFD700"/>
    <SolidColorBrush x:Key="BadgeDarkTextBrush" Color="{StaticResource SurfaceColor}"/>  <!-- Text on light badges -->

    <!-- Status banner: a tinted background and a readable text colour per message type -->
    <SolidColorBrush x:Key="InfoBannerBrush" Color="#26FFB6D9"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="SuccessBannerBrush" Color="#3390EE90"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#CC90EE90"/>
    <SolidColorBrush x:Key="WarningBannerBrush" Color="#33FFD700"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#CCFFD700"/>
    <SolidColorBrush x:Key="ErrorBannerBrush" Color="#40FF4444"/>   <!-- Errors must not look like the pink accent -->
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF7A7A"/>

</ResourceDictionary>
