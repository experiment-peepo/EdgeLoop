<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EdgeLoop.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
        <ResourceDictionary Source="Typography.xaml"/>
        <ResourceDictionary Source="Icons.xaml"/>
        <ResourceDictionary Source="Buttons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Window chrome (see Controls/EdgeLoopWindow.cs) ===== -->

    <!-- The title bar is 40px: the top 6px resize the window, the rest drags it -->
    <WindowChrome x:Key="ResizableWindowChrome"
                  CaptionHeight="34"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0,0,0,1"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
    <WindowChrome x:Key="FixedWindowChrome"
                  CaptionHeight="40"
                  ResizeBorderThickness="0"
                  GlassFrameThickness="0,0,0,1"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False"/>

    <Style x:Key="EdgeLoopWindowStyle" TargetType="controls:EdgeLoopWindow">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WindowBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Icon" Value="pack://application:,,,/EdgeLoop;component/Images/icon.ico"/>
        <Setter Property="WindowChrome.WindowChrome" Value="{StaticResource ResizableWindowChrome}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EdgeLoopWindow">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding ChromePadding}">
                        <Border x:Name="WindowRoot" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Title bar -->
                                <Border Height="40" Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{TemplateBinding Icon}" Width="16" Height="16" Margin="14,0,10,0"
                                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <DockPanel x:Name="TitlePanel" Grid.Column="1" VerticalAlignment="Center" LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Title}"
                                                       FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SubtitleText" Text="{TemplateBinding Subtitle}" Margin="10,1,8,0"
                                                       FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <ContentPresenter Grid.Column="2" Content="{TemplateBinding TitleBarContent}"
                                                          WindowChrome.IsHitTestVisibleInChrome="True"/>

                                        <Button x:Name="MinimizeButton" Grid.Column="3"
                                                Style="{StaticResource TitleBarButtonStyle}"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                                IsTabStop="False" ToolTip="Minimize" AutomationProperties.Name="Minimize"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                            <Path Data="{StaticResource Icon_Minimize}" Stretch="Uniform" Width="10" Height="10"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button x:Name="MaximizeButton" Grid.Column="4"
                                                Style="{StaticResource TitleBarButtonStyle}"
                                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                                IsTabStop="False" ToolTip="Maximize" AutomationProperties.Name="Maximize"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                            <Path x:Name="MaximizeIcon" Data="{StaticResource Icon_Maximize}" Stretch="Uniform" Width="10" Height="10"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button x:Name="CloseButton" Grid.Column="5"
                                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                                IsTabStop="False" ToolTip="Close" AutomationProperties.Name="Close"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                            <Path Data="{StaticResource Icon_Close}" Stretch="Uniform" Width="10" Height="10"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <AdornerDecorator Grid.Row="1">
                                    <ContentPresenter/>
                                </AdornerDecorator>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="TitlePanel" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MinimizeButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="MaximizeButton" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/>
                            <Setter TargetName="MaximizeButton" Property="ToolTip" Value="Restore"/>
                            <Setter TargetName="MaximizeButton" Property="AutomationProperties.Name" Value="Restore"/>
                            <Setter TargetName="MaximizeIcon" Property="Data" Value="{StaticResource Icon_Restore}"/>
                            <Setter TargetName="WindowRoot" Property="BorderThickness" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ResizeMode" Value="NoResize">
                <Setter Property="WindowChrome.WindowChrome" Value="{StaticResource FixedWindowChrome}"/>
            </Trigger>
            <Trigger Property="ResizeMode" Value="CanMinimize">
                <Setter Property="WindowChrome.WindowChrome" Value="{StaticResource FixedWindowChrome}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Content area of a dialog, and its right-aligned button row (secondary, then primary) -->
    <Style x:Key="DialogContentPanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="24,22,24,0"/>
    </Style>
    <Style x:Key="DialogButtonRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="24,20,24,24"/>
    </Style>

    <!-- ===== Surfaces ===== -->

    <Style x:Key="PinkSeparator" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BorderPink}"/>
        <Setter Property="Opacity" Value="0.3"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- A raised card, e.g. a settings group or a playlist item -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="6"
                            MaxWidth="420">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
